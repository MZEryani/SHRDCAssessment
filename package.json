{
  "name": "shrdc-assessment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenPLC v4 + Open Industry Project Conveyor Cell integration and OpenCode multi-agent workflow",
  "scripts": {
    "plc:deploy": "node scripts/openplc-deploy.mjs",
    "plc:deploy:cell": "node scripts/openplc-deploy.mjs scenes/conveyor-cell/plc/program.st openplc/conveyor_cell_modbus_master.json",
    "plc:test": "node scripts/plc-test.mjs",
    "oip:validate": "node scripts/validate-oip-cell.mjs",
    "oip:desktop": "node scripts/oip-desktop.mjs",
    "cell:verify": "node scripts/verify-cell.mjs",
    "test:contract": "node --test tests/io-contract.test.mjs",
    "test:plc-bundle": "node --test tests/plc-bundle.test.mjs",
    "test:openplc-runtime": "node --test tests/openplc-runtime.test.mjs",
    "test:harness": "node --test tests/cell-harness.test.mjs",
    "test:tracer": "node --test tests/tracer-modbus.test.mjs",
    "test:e2e": "node --test tests/conveyor-cell-e2e.test.mjs",
    "test:opencode": "node --test tests/opencode-config.test.mjs",
    "test:orchestrate": "node --test tests/opencode-runner.test.mjs tests/git-worktree-workspace.test.mjs tests/orchestrate-cell.test.mjs",
    "opencode:probe": "node scripts/opencode-probe.mjs",
    "orchestrate": "node scripts/orchestrate-cell.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "verify:offline": "npm run test:contract && npm run plc:test && npm run oip:validate && npm run test:opencode && npm run test:orchestrate && npm run test:plc-bundle && npm run test:harness && npm run test:openplc-runtime",
    "verify:all": "npm run verify:offline && npm run test:tracer && npm run test:e2e"
  }
}
